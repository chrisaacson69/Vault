# Default: exclude all non-markdown files in raw/
# These are source materials that can be re-fetched from URLs in page frontmatter.

# Exclude by type
*.srt
*.vtt
*.srv1
*.txt
*.pdf
*.mp3
*.mp4
*.wav
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.docx
*.html

# Always track markdown (Web Clipper drops, processed articles)
!*.md

# Always track git infrastructure
!.gitignore
!.gitkeep

# ============================================================
# WHITELIST: non-reproducible files that should be tracked.
# Add files here when they are referenced by vault pages
# and cannot be re-fetched from a source URL.
# ============================================================
!articles/demolition-man-script.txt
!output/transaction-multiplier-chart.png
!output/k12-instruction-vs-administration.html
!output/us-spending-per-student.html

# ============================================================
# WORK-SOURCED CAPTURES — never tracked. The vault repo is PUBLIC.
# Employer-derived captures keep their real class/method/proc names
# locally as the immutable source; only *.anon.md copies are tracked.
# ============================================================
# General rule: everything under work/ is local-only, whatever its extension.
# Track ONLY anonymized copies (*.anon.md), anywhere under raw/.
work/**
!work/**/*.anon.md

# Pre-dating that rule: the 2026-08-26 cold-read capture.
datasets/comment-oracle-coldread-2026-08-26/README.md
datasets/comment-oracle-coldread-2026-08-26/protocol.md
datasets/comment-oracle-coldread-2026-08-26/results-relayed.md
!**/*.anon.md
